rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    // ---- MEMBRESÍA ----
    // El administrador (dueño de ApiCampo). Nadie más puede abrir una cuenta
    // con este correo porque Firebase no permite correos repetidos.
    function esAdmin() {
      return estaAutenticado() && request.auth.token.email == 'juceas19@gmail.com';
    }
    // Puede escribir (crear/editar) quien es admin o tiene plan vigente.
    // Leer y borrar no se bloquea nunca: con la membresía vencida la persona
    // sigue viendo y descargando sus datos.
    function membresiaVigente() {
      return esAdmin() ||
        (estaAutenticado() &&
         ((exists(/databases/$(database)/documents/planes/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/planes/$(request.auth.uid)).data.vence > request.time.toMillis()) ||
          (exists(/databases/$(database)/documents/provisional/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/provisional/$(request.auth.uid)).data.hasta > request.time.toMillis())));
    }

    // El plan vigente de OTRA persona (el dueño de un apiario compartido):
    // los socios invitados trabajan dentro del plan del dueño.
    function planVigenteDeUid(u) {
      return u != null &&
        exists(/databases/$(database)/documents/planes/$(u)) &&
        get(/databases/$(database)/documents/planes/$(u)).data.vence > request.time.toMillis();
    }
    function duenoVigente(apiarioId) {
      return planVigenteDeUid(apiarioDespuesDe(apiarioId).propietarioId);
    }
    // Invitar socios: solo plan Pro Sociedades vigente (la prueba gratis no lo incluye).
    function puedeInvitar() {
      return esAdmin() ||
        (estaAutenticado() &&
         exists(/databases/$(database)/documents/planes/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/planes/$(request.auth.uid)).data.vence > request.time.toMillis() &&
         get(/databases/$(database)/documents/planes/$(request.auth.uid)).data.plan == 'pro');
    }

    function esDuenoOColaboradorDe(apiario) {
      return apiario != null && estaAutenticado() &&
        (request.auth.uid == apiario.propietarioId ||
         request.auth.uid in apiario.get('colaboradoresUids', []));
    }

    function esDuenoDe(apiario) {
      return apiario != null && estaAutenticado() && request.auth.uid == apiario.propietarioId;
    }

    function apiarioDe(apiarioId) {
      return exists(/databases/$(database)/documents/apiarios/$(apiarioId))
        ? get(/databases/$(database)/documents/apiarios/$(apiarioId)).data
        : null;
    }

    function apiarioDespuesDe(apiarioId) {
      return existsAfter(/databases/$(database)/documents/apiarios/$(apiarioId))
        ? getAfter(/databases/$(database)/documents/apiarios/$(apiarioId)).data
        : null;
    }

    function invitacionValidaPara(apiarioId) {
      return estaAutenticado() && request.auth.token.email != null &&
        exists(/databases/$(database)/documents/invitaciones/$(apiarioId + '_' + request.auth.token.email));
    }

    function soloSeAgregaASiMismo(antes, despues) {
      return despues.colaboradoresUids is list &&
        despues.colaboradoresUids.size() == (antes.colaboradoresUids is list ? antes.colaboradoresUids.size() : 0) + 1 &&
        request.auth.uid in despues.colaboradoresUids &&
        (antes.colaboradoresUids is list ? despues.colaboradoresUids.hasAll(antes.colaboradoresUids) : true);
    }

    // CORRECCIÓN 1: nadie puede cambiar el dueño de un apiario.
    function noCambiaDueno() {
      return request.resource.data.propietarioId == resource.data.propietarioId;
    }

    // CORRECCIÓN 1: un colaborador puede editar el apiario (giras, socios,
    // nombre...), pero no el dueño ni la lista de colaboradores.
    function cambiosPermitidosAColaborador() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['propietarioId', 'colaboradoresUids', 'colaboradoresInfo']);
    }

    match /planes/{uid} {
      allow read: if estaAutenticado() && (request.auth.uid == uid || esAdmin());
      // La prueba gratis la crea la propia persona una sola vez (máx. 31 días).
      allow create: if estaAutenticado() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['plan','vence','creado','correo']) &&
        request.resource.data.plan == 'prueba' &&
        request.resource.data.vence <= request.time.toMillis() + 31 * 86400000;
      allow update, delete: if esAdmin();
      allow create: if esAdmin();
    }

    // Activación provisional de 3 días mientras se revisa un comprobante.
    // La persona solo puede crearla una vez; el administrador puede reiniciarla.
    match /provisional/{uid} {
      allow read: if estaAutenticado() && (request.auth.uid == uid || esAdmin());
      allow create: if estaAutenticado() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['hasta']) &&
        request.resource.data.hasta <= request.time.toMillis() + 3 * 86400000 + 3600000;
      allow write: if esAdmin();
    }

    // Comprobantes de pago (foto reducida dentro del documento).
    match /pagos/{pagoId} {
      allow read: if estaAutenticado() && (resource.data.uid == request.auth.uid || esAdmin());
      allow create: if estaAutenticado() &&
        request.resource.data.keys().hasOnly(['uid','correo','plan','periodo','monto','foto','estado','creado']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.estado == 'pendiente' &&
        request.resource.data.plan in ['basico','estandar','pro'] &&
        request.resource.data.periodo in ['mes','anio'] &&
        request.resource.data.foto is string && request.resource.data.foto.size() < 600000;
      allow update, delete: if esAdmin();
    }

    // Datos de pago (WhatsApp, cuenta) que ve cada usuario; solo el admin los cambia.
    match /config/{docId} {
      allow read: if estaAutenticado();
      allow write: if esAdmin();
    }

    match /apiarios/{apiarioId} {
      allow read: if esDuenoOColaboradorDe(resource.data);
      allow create: if membresiaVigente() && request.resource.data.propietarioId == request.auth.uid;
      allow update: if (membresiaVigente() || planVigenteDeUid(resource.data.propietarioId)) && (
        (esDuenoDe(resource.data) && noCambiaDueno()) ||
        (esDuenoOColaboradorDe(resource.data) && cambiosPermitidosAColaborador()) ||
        (invitacionValidaPara(apiarioId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['colaboradoresUids','colaboradoresInfo']) &&
         soloSeAgregaASiMismo(resource.data, request.resource.data)));
      allow delete: if request.auth.uid == resource.data.propietarioId;
    }

    match /invitaciones/{invId} {
      // CORRECCIÓN 2: solo el dueño real del apiario puede invitar a alguien.
      allow create: if puedeInvitar() && request.resource.data.propietarioId == request.auth.uid &&
        invId == request.resource.data.apiarioId + '_' + request.resource.data.correoInvitado &&
        esDuenoDe(apiarioDe(request.resource.data.apiarioId));
      allow read, delete: if estaAutenticado() &&
        (request.auth.uid == resource.data.propietarioId || request.auth.token.email == resource.data.correoInvitado);
      allow update: if false;
    }

    function coleccionHija(apiarioId) {
      return esDuenoOColaboradorDe(apiarioDe(apiarioId));
    }

    function coleccionHijaAlEscribir(apiarioId) {
      return esDuenoOColaboradorDe(apiarioDespuesDe(apiarioId));
    }

    // CORRECCIÓN 3: al editar un registro, el apiario nuevo también debe ser
    // propio o compartido (antes se podía pasar un registro a un apiario ajeno).
    match /colmenas/{docId} {
      allow read, delete: if coleccionHija(resource.data.apiarioId);
      allow update: if (membresiaVigente() || duenoVigente(request.resource.data.apiarioId)) && coleccionHija(resource.data.apiarioId) && coleccionHijaAlEscribir(request.resource.data.apiarioId);
      allow create: if (membresiaVigente() || duenoVigente(request.resource.data.apiarioId)) && coleccionHijaAlEscribir(request.resource.data.apiarioId);
    }
    match /revisiones/{docId} {
      allow read, delete: if coleccionHija(resource.data.apiarioId);
      allow update: if (membresiaVigente() || duenoVigente(request.resource.data.apiarioId)) && coleccionHija(resource.data.apiarioId) && coleccionHijaAlEscribir(request.resource.data.apiarioId);
      allow create: if (membresiaVigente() || duenoVigente(request.resource.data.apiarioId)) && coleccionHijaAlEscribir(request.resource.data.apiarioId);
    }
    match /tratamientos/{docId} {
      allow read, delete: if coleccionHija(resource.data.apiarioId);
      allow update: if (membresiaVigente() || duenoVigente(request.resource.data.apiarioId)) && coleccionHija(resource.data.apiarioId) && coleccionHijaAlEscribir(request.resource.data.apiarioId);
      allow create: if (membresiaVigente() || duenoVigente(request.resource.data.apiarioId)) && coleccionHijaAlEscribir(request.resource.data.apiarioId);
    }
    match /alimentaciones/{docId} {
      allow read, delete: if coleccionHija(resource.data.apiarioId);
      allow update: if (membresiaVigente() || duenoVigente(request.resource.data.apiarioId)) && coleccionHija(resource.data.apiarioId) && coleccionHijaAlEscribir(request.resource.data.apiarioId);
      allow create: if (membresiaVigente() || duenoVigente(request.resource.data.apiarioId)) && coleccionHijaAlEscribir(request.resource.data.apiarioId);
    }
    match /trabajos/{docId} {
      allow read, delete: if coleccionHija(resource.data.apiarioId);
      allow update: if (membresiaVigente() || duenoVigente(request.resource.data.apiarioId)) && coleccionHija(resource.data.apiarioId) && coleccionHijaAlEscribir(request.resource.data.apiarioId);
      allow create: if (membresiaVigente() || duenoVigente(request.resource.data.apiarioId)) && coleccionHijaAlEscribir(request.resource.data.apiarioId);
    }
    match /cosechas/{docId} {
      allow read, delete: if coleccionHija(resource.data.apiarioId);
      allow update: if (membresiaVigente() || duenoVigente(request.resource.data.apiarioId)) && coleccionHija(resource.data.apiarioId) && coleccionHijaAlEscribir(request.resource.data.apiarioId);
      allow create: if (membresiaVigente() || duenoVigente(request.resource.data.apiarioId)) && coleccionHijaAlEscribir(request.resource.data.apiarioId);
    }

    function documentoGeneralPropio(d) {
      return estaAutenticado() && d.get('propietarioId', null) == request.auth.uid;
    }

    // Permiso sobre un documento que puede ser "general" (sin apiario) o de un apiario.
    function puedeLeerGeneralOHijo(d) {
      return d.get('apiarioId', null) == null ? documentoGeneralPropio(d) : coleccionHija(d.apiarioId);
    }
    function escrituraPermitida(d) {
      return membresiaVigente() ||
        (d.get('apiarioId', null) != null && duenoVigente(d.apiarioId));
    }
    function puedeEscribirGeneralOHijo(d) {
      return d.get('apiarioId', null) == null
        ? documentoGeneralPropio(d)
        : (estaAutenticado() && coleccionHijaAlEscribir(d.apiarioId));
    }

    match /inversiones/{docId} {
      allow read, delete: if puedeLeerGeneralOHijo(resource.data);
      allow update: if escrituraPermitida(request.resource.data) && puedeLeerGeneralOHijo(resource.data) && puedeEscribirGeneralOHijo(request.resource.data);
      allow create: if escrituraPermitida(request.resource.data) && puedeEscribirGeneralOHijo(request.resource.data);
    }

    match /notas/{docId} {
      allow read, delete: if puedeLeerGeneralOHijo(resource.data);
      allow update: if escrituraPermitida(request.resource.data) && puedeLeerGeneralOHijo(resource.data) && puedeEscribirGeneralOHijo(request.resource.data);
      allow create: if escrituraPermitida(request.resource.data) && puedeEscribirGeneralOHijo(request.resource.data);
    }
  }
}
